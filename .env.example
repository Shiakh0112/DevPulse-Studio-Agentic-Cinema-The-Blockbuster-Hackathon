# ==============================================================================
# DevPulse Studio - Master Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' at the project root and fill in your environment values:
#   cp .env.example .env
#
# DO NOT COMMIT REAL API KEYS OR PRODUCTION PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# ==============================================================================
# 1. ClickHouse Database Configuration (used by agent/ & apps/web & mcp/)
# ==============================================================================
CLICKHOUSE_HOST=https://your-clickhouse-cloud-instance.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_cloud_password_here
CLICKHOUSE_DB=devpulse
CLICKHOUSE_SECURE=true

# ==============================================================================
# 2. Google Cloud AI & Gemini 1.5 Pro Configuration (used by agent/ & Cloud Run)
# ==============================================================================
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ==============================================================================
# 3. GitHub Integration Configuration (used by agent/ & apps/web)
# ==============================================================================
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_DEMO_REPO=devpulse-org/media-rendering-pipeline
VERIFICATION_TARGET_REPO=devpulse-org/media-rendering-pipeline

# ==============================================================================
# 4. Service Endpoints & Orchestrator URLs (used by apps/web & agent/)
# ==============================================================================
AGENT_ORCHESTRATOR_URL=http://localhost:8000
MCP_CLICKHOUSE_URL=http://localhost:8080
AGENT_SERVICE_URL=http://localhost:8000

# ==============================================================================
# 5. Multi-Channel Notification Webhooks (used by agent/ & apps/web)
# ==============================================================================
# Options for NOTIFICATION_PLATFORM: slack | discord | telegram | all
NOTIFICATION_PLATFORM=slack

# Slack Interactive Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL
SLACK_SIGNING_SECRET=your_slack_app_signing_secret_here

# Discord Webhook Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD_WEBHOOK_URL

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ_your_bot_token
TELEGRAM_CHAT_ID=-100123456789

# ==============================================================================
# 6. Auto-Rollback & ROI Calculation Parameters (used by agent/ & apps/web)
# ==============================================================================
ROLLBACK_USER_THRESHOLD=500
DEV_HOURLY_RATE=85
